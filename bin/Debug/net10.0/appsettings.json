{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    }
  },
  "ConnectionStrings": {
    "MyConnection": "Data Source=MyProject.db"
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Key": "ThisIsMyVerySecretKeyForJwtToken123456",
    "Issuer": "backend-api",
    "Audience": "backend-client"
  }
}